# Backend Environment Variables
# Copy this file to .env and fill in your values

# Server
PORT=8000
NODE_ENV=development

# MongoDB (MONGODB_URI is preferred; MONGO_URL is supported as legacy alias)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net
# MONGO_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net

# JWT (JWT_SECRET is preferred; JWT_SECRET_CODE is supported as legacy alias)
JWT_SECRET=your-super-secret-jwt-key-change-me
# JWT_SECRET_CODE=your-super-secret-jwt-key-change-me

# Cloudinary (required in production)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# CORS - comma-separated list of allowed origins
# In production, add your Netlify frontend URL
CORS_ORIGINS=http://localhost:5173,https://your-app.netlify.app

# Client URL (used for CORS fallback)
CLIENT_URL=http://localhost:5173

# Logging
LOG_LEVEL=debug
